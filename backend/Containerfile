# One image for the API, the worker and one-off commands (migrate, schedule_nightly).
# Build from the backend folder:  podman build -t collectiq-backend:local backend
FROM docker.io/library/python:3.12-slim AS build
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/venv
RUN pip install --no-cache-dir uv
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

FROM docker.io/library/python:3.12-slim
ENV PATH=/opt/venv/bin:$PATH PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 DJANGO_ENV=production
RUN useradd --system --uid 10001 --home-dir /app collectiq && mkdir -p /data && chown collectiq /data
COPY --from=build /opt/venv /opt/venv
WORKDIR /app
COPY --chown=collectiq manage.py ./
COPY --chown=collectiq collectiq ./collectiq
USER collectiq
EXPOSE 8000
CMD ["gunicorn", "collectiq.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "3", "--access-logfile", "-"]
