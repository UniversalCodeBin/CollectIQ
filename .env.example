# Placeholders only. `make env` writes a real .env with random local secrets.
# Never commit .env. Never reuse these values anywhere.
DJANGO_ENV=local
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

POSTGRES_PASSWORD=change-me
COLLECTIQ_OWNER_PASSWORD=change-me
COLLECTIQ_APP_PASSWORD=change-me
# Runtime connection: non-owner role that cannot bypass row-level security.
DATABASE_URL=postgres://collectiq_app:change-me@127.0.0.1:54329/collectiq
# Migrations only: owner role.
MIGRATION_DATABASE_URL=postgres://collectiq_owner:change-me@127.0.0.1:54329/collectiq

# 32 random bytes, base64. Local stand-in for a KMS; wraps per-workspace data keys.
COLLECTIQ_MASTER_KEY=change-me
COLLECTIQ_STORAGE_DIR=var/storage
# memory | file. Only local backends exist. Nothing is delivered to a real mailbox.
EMAIL_BACKEND_KIND=file
EMAIL_FILE_PATH=var/mail
# Where links in email point: the web app.
APP_BASE_URL=http://localhost:5173

# AI stays off until a provider is approved (OD-05). `fake` is for tests and is refused in production.
AI_PROVIDER=none
AI_KILL_SWITCH=false

# Feature flags, default off.
FEATURE_PDF_EXTRACTION=false
FEATURE_GMAIL_SEND=false
FEATURE_PAYPAL_WEBHOOK=false
